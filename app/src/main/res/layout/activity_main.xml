<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ECE9D8">

    <LinearLayout
        android:id="@+id/titleBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:background="#3A6EA5"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>
        <ImageButton
            android:id="@+id/btnToggleUI"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/toggle_ui"
            android:src="@android:drawable/ic_menu_more"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttonPanel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#D4D0C8"
        android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnBack"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/back"
            android:src="@android:drawable/ic_media_previous"/>
        <ImageButton android:id="@+id/btnForward"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/forward"
            android:src="@android:drawable/ic_media_next"/>
        <ImageButton android:id="@+id/btnReload"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/reload"
            android:src="@android:drawable/ic_popup_sync"/>
        <ImageButton android:id="@+id/btnHome"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/home"
            android:src="@android:drawable/ic_menu_compass"/>
        <ImageButton android:id="@+id/btnScreenshot"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/screenshot"
            android:src="@android:drawable/ic_menu_camera"/>
        <ImageButton android:id="@+id/btnSavePage"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/save_page"
            android:src="@android:drawable/ic_menu_save"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#D4D0C8"
        android:padding="4dp"
        android:gravity="center_vertical">
        <EditText
            android:id="@+id/addressBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/address_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:background="#FFFFFF"
            android:padding="8dp"/>
        <ImageButton
            android:id="@+id/btnGo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/go"
            android:src="@android:drawable/ic_menu_send"/>
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
